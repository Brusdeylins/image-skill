{
  "name": "@brusdeylins/nano-banana",
  "version": "0.10.0",
  "description": "Deterministic image/video-generation CLI for LLM agents: Google Nano Banana (Gemini Image API) and Veo (Gemini Video API) -- text-to-image, image-to-image and text/image-to-video, model-aware aspect ratios and resolutions",
  "keywords": [
    "gemini",
    "nano-banana",
    "veo",
    "image-generation",
    "image-editing",
    "image-to-image",
    "video-generation",
    "image-to-video",
    "cli",
    "llm",
    "agent",
    "aspect-ratio"
  ],
  "license": "MIT",
  "author": "Matthias Brusdeylins <brusdeylins@gmx.de>",
  "homepage": "https://github.com/brusdeylins/image-skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brusdeylins/image-skill.git"
  },
  "bugs": {
    "url": "https://github.com/brusdeylins/image-skill/issues"
  },
  "type": "module",
  "bin": {
    "nano-banana": "dst/nano-banana.mjs"
  },
  "files": [
    "dst",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "plugin:sync": "npm run build && cp dst/nano-banana.mjs plugin/skills/image/scripts/nano-banana.mjs && node scripts/sync-versions.mjs",
    "test": "vitest run",
    "lint": "eslint src test && tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
